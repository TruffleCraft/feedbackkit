# Copy to .env. Generate a token: openssl rand -hex 32
ADMIN_TOKEN=
FK_PUBLIC_URL=http://localhost:8787
# Optional. Keep blank to use required-field forms without an AI service.
LLM_API_KEY=
# Only needed for GitHub issue or Project delivery. Inbox-only needs no token.
GITHUB_PAT_default=
# Number of reverse proxies in front of this server (0 = none). The visitor address
# is read from X-Forwarded-For through that many proxies, counted from the right.
FK_TRUSTED_PROXY_HOPS=0
# MCP for agents at /mcp. Off, and it stays off until accounts exist: approving a connection needs a sign-in.
# "on" serves the OAuth endpoints anyway, but no connection can be approved (see docs/SELF_HOSTING.md).
# FK_MCP=
