#!/bin/sh
# feedbackkit-update: check for, install and roll back FeedbackKit releases of the
# standalone server (docs/SELF_HOSTING.md). POSIX sh. It needs Node.js (already
# there to run the server) and curl, tar, sha256sum and ssh-keygen. Nothing runs
# unless you run it or subscribe to a channel (--auto on), and the only request it
# makes is a plain read of the GitHub Releases API.
#
#   feedbackkit-update --check                 what is installed, what is the newest release
#   feedbackkit-update                         update to the newest release of the channel
#   feedbackkit-update --channel dev           take dev builds as well (default: stable, or dev
#                                              when a dev build is installed)
#   feedbackkit-update --rollback              go back to the previous release and its data
#   feedbackkit-update --auto on [--channel dev] [--at HH:MM]
#                                              subscribe: a systemd timer runs the update every
#                                              night (default 03:30, up to 30 minutes later)
#   feedbackkit-update --auto off              unsubscribe
#   feedbackkit-update --auto status           show the subscription
#   feedbackkit-update --unattended            what the timer runs: an update that skips a release
#                                              which failed to start before, until a newer one exists
#
# Layout: $FK_BASE/releases/<version>/ per release, $FK_BASE/current -> the running one,
# $FK_BASE/previous -> the one before. Exit codes: 0 done or up to date, 1 failed (the
# installation is as it was before), 10 with --check: an update is available.
# --auto needs root. The timer runs $FK_BASE/current/feedbackkit-update, so every update
# also brings the newer updater.
set -eu

FK_BASE="${FK_BASE:-/opt/feedbackkit}"
FK_DATA_DIR="${FK_DATA_DIR:-/var/lib/feedbackkit}"
FK_SERVICE="${FK_SERVICE:-feedbackkit}"
FK_SYSTEMCTL="${FK_SYSTEMCTL:-systemctl}"
FK_API="${FK_API:-https://api.github.com/repos/TruffleCraft/feedbackkit}"
FK_ENV_FILE="${FK_ENV_FILE:-/etc/feedbackkit.env}"
FK_HEALTH_SECONDS="${FK_HEALTH_SECONDS:-30}"
FK_UNIT_DIR="${FK_UNIT_DIR:-/etc/systemd/system}"
UNIT="feedbackkit-update"
NAMESPACE="feedbackkit-release"

mode=update
channel=""
auto=""
at=""
unattended=""
while [ $# -gt 0 ]; do
  case "$1" in
    --check) mode=check ;;
    --rollback) mode=rollback ;;
    --channel) shift; channel="${1:-}" ;;
    --auto) mode=auto; shift; auto="${1:-}" ;;
    --at) shift; at="${1:-}" ;;
    --unattended) unattended=1 ;;
    -h|--help) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "feedbackkit-update: unknown option $1 (see --help)" >&2; exit 1 ;;
  esac
  [ $# -eq 0 ] || shift  # an option that wants a value may have taken the last argument
done
case "$channel" in ""|stable|dev) ;; *) echo "feedbackkit-update: --channel is stable or dev" >&2; exit 1 ;; esac
case "$auto" in ""|on|off|status) ;; *) echo "feedbackkit-update: --auto is on, off or status" >&2; exit 1 ;; esac
if [ "$mode" = auto ] && [ -z "$auto" ]; then echo "feedbackkit-update: --auto is on, off or status" >&2; exit 1; fi

say() { printf '%s\n' "$*"; }
die() { printf 'feedbackkit-update: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required"; }
need node; need curl; need tar; need ssh-keygen
if command -v sha256sum >/dev/null 2>&1; then SHA="sha256sum"; else need shasum; SHA="shasum -a 256"; fi

[ -L "$FK_BASE/current" ] || die "$FK_BASE/current is not a link to a release. See docs/SELF_HOSTING.md for the layout."

# Node does the JSON and version work, so no other tool has to.
JS='
const fs = require("fs");
const parse = (v) => { const m = /^v?(\d+)\.(\d+)\.(\d+)(?:-dev\.(\d+))?$/.exec(v); return m ? [+m[1], +m[2], +m[3], m[4] === undefined ? Infinity : +m[4]] : null; };
const cmp = (a, b) => { for (let i = 0; i < 4; i++) if (a[i] !== b[i]) return a[i] < b[i] ? -1 : 1; return 0; };
const [op, ...args] = process.argv.slice(1);
if (op === "release") { // read bundle.json: release channel schemaVersion
  const m = JSON.parse(fs.readFileSync(args[0], "utf8"));
  console.log([m.release, m.channel, m.schemaVersion].join(" "));
} else if (op === "compare") { // newer | same | older
  const a = parse(args[0]), b = parse(args[1]);
  console.log(!a || !b ? "invalid" : cmp(a, b) > 0 ? "newer" : cmp(a, b) < 0 ? "older" : "same");
} else if (op === "pick") { // stdin: release JSON from the GitHub API, args: channel
  let s = ""; process.stdin.on("data", (d) => (s += d)).on("end", () => {
    const list = [].concat(JSON.parse(s)).filter((r) => r && !r.draft && parse(r.tag_name));
    const ok = list.filter((r) => args[0] === "dev" || (!r.prerelease && !/-dev\./.test(r.tag_name)));
    ok.sort((x, y) => cmp(parse(y.tag_name), parse(x.tag_name)));
    const r = ok[0]; if (!r) process.exit(3);
    const url = (n) => (r.assets.find((a) => a.name === n) || {}).browser_download_url || "";
    const v = r.tag_name.replace(/^v/, "");
    console.log([v, url(`feedbackkit-v${v}.tar.gz`), url("SHA256SUMS"), url("SHA256SUMS.sig")].join(" "));
  });
} else if (op === "health") { // stdin: /diag, args: version
  let s = ""; process.stdin.on("data", (d) => (s += d)).on("end", () => {
    try { const d = JSON.parse(s); process.exit(d.version === args[0] && d.schema && d.schema.ok ? 0 : 1); } catch { process.exit(1); }
  });
}
'
js() { node -e "$JS" "$@"; }

current_dir="$(cd "$FK_BASE/current" && pwd -P)"
read -r current_release current_channel _ <<EOF
$(js release "$current_dir/bundle.json")
EOF
[ -n "$channel" ] || { [ "$current_channel" = "dev" ] && channel=dev || channel=stable; }

# ---- subscription -----------------------------------------------------------------------
# A systemd timer runs `feedbackkit-update --unattended`. Everything else (signature, data copy,
# health check, automatic restore) is the ordinary update. Off by default.
unit() { "$FK_SYSTEMCTL" "$@"; }
if [ "$mode" = auto ]; then
  case "$auto" in
    on)
      case "$at" in
        "") at="03:30" ;;
        [01][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9]) ;;
        *) die "--at is a time of day as HH:MM, for example 03:30" ;;
      esac
      [ -x "$FK_BASE/current/feedbackkit-update" ] || die "$FK_BASE/current/feedbackkit-update is missing or not executable. This release does not carry the updater the timer needs."
      [ -w "$FK_UNIT_DIR" ] || die "cannot write to $FK_UNIT_DIR. Run this with sudo."
      cat > "$FK_UNIT_DIR/$UNIT.service" <<EOF
[Unit]
Description=FeedbackKit update (channel $channel)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=$FK_BASE/current/feedbackkit-update --unattended --channel $channel
EOF
      cat > "$FK_UNIT_DIR/$UNIT.timer" <<EOF
[Unit]
Description=Update FeedbackKit every night (channel $channel)

[Timer]
OnCalendar=*-*-* $at:00
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
EOF
      unit daemon-reload
      unit enable --now "$UNIT.timer"
      say "Subscribed to the $channel channel: every night at $at (up to 30 minutes later), unattended."
      say "Look at it with: feedbackkit-update --auto status. A failed run shows in: journalctl -u $UNIT"
      ;;
    off)
      if [ -e "$FK_UNIT_DIR/$UNIT.timer" ]; then
        unit disable --now "$UNIT.timer" || true
        rm -f "$FK_UNIT_DIR/$UNIT.timer" "$FK_UNIT_DIR/$UNIT.service"
        unit daemon-reload
        say "Unsubscribed. Nothing updates unless you run feedbackkit-update."
      else
        say "There is no subscription."
      fi
      ;;
    status)
      if [ ! -e "$FK_UNIT_DIR/$UNIT.timer" ]; then say "Subscription: off. Nothing updates unless you run feedbackkit-update."; exit 0; fi
      sub_channel="$(sed -n 's/^ExecStart=.* --channel //p' "$FK_UNIT_DIR/$UNIT.service" | head -n 1)"
      sub_time="$(sed -n 's/^OnCalendar=\*-\*-\* //p' "$FK_UNIT_DIR/$UNIT.timer" | head -n 1)"
      say "Subscription: on ($(unit is-enabled "$UNIT.timer" 2>/dev/null || echo unknown))"
      say "Channel: ${sub_channel:-unknown}"
      say "Runs: every night at ${sub_time%:00} (up to 30 minutes later)"
      say "Installed: $current_release ($current_channel)"
      if [ -r "$FK_BASE/auto-skip" ]; then say "Skipped: $(cat "$FK_BASE/auto-skip") (it failed to start on an unattended run; the next newer release is tried)"; fi
      ;;
  esac
  exit 0
fi

health_url() {
  if [ -n "${FK_HEALTH_URL:-}" ]; then printf '%s' "$FK_HEALTH_URL"; return; fi
  port=8787
  if [ -r "$FK_ENV_FILE" ]; then p="$(sed -n 's/^PORT=//p' "$FK_ENV_FILE" | tail -n 1)"; [ -z "$p" ] || port="$p"; fi
  printf 'http://127.0.0.1:%s/diag' "$port"
}
service() { "$FK_SYSTEMCTL" "$1" "$FK_SERVICE"; }
healthy() { # the running release is the one we expect and its schema is fine
  end=$(( $(date +%s) + FK_HEALTH_SECONDS ))
  while [ "$(date +%s)" -lt "$end" ]; do
    if curl -fsS --max-time 3 "$(health_url)" 2>/dev/null | js health "$1" 2>/dev/null; then return 0; fi
    sleep 1
  done
  return 1
}
link() { rm -f "$FK_BASE/$1"; ln -s "$2" "$FK_BASE/$1"; }
link_target() { [ -L "$FK_BASE/$1" ] && basename "$(readlink "$FK_BASE/$1")" || true; }

# ---- rollback -------------------------------------------------------------------------
if [ "$mode" = rollback ]; then
  prev="$(link_target previous)"
  [ -n "$prev" ] && [ -d "$FK_BASE/releases/$prev" ] || die "there is no previous release to go back to"
  backup="$FK_DATA_DIR.backup-$prev"
  [ -d "$backup" ] || die "the data copy $backup is missing, so a rollback would run the old release on newer data"
  now="$(basename "$current_dir")"
  say "Rolling back $now to $prev. The data goes back to the copy taken before the update."
  service stop
  aside="$FK_DATA_DIR.after-rollback-$(date +%Y%m%d%H%M%S)"
  mv "$FK_DATA_DIR" "$aside"
  cp -a "$backup" "$FK_DATA_DIR"
  link previous "releases/$now"
  link current "releases/$prev"
  service start
  if healthy "$prev"; then
    say "Rolled back to $prev. Reports received since the update are in $aside."
    exit 0
  fi
  die "release $prev did not become healthy. The data of $now is in $aside, the copy in $backup."
fi

# ---- find the newest release ---------------------------------------------------------
case "$channel" in dev) api="$FK_API/releases?per_page=30" ;; *) api="$FK_API/releases/latest" ;; esac
tmp="$(mktemp -d)"; stage=""
trap 'rm -rf "$tmp"; [ -z "$stage" ] || rm -rf "$stage"' EXIT INT TERM
curl -fsS --retry 2 --max-time 30 -A feedbackkit-update -H 'Accept: application/vnd.github+json' -o "$tmp/api.json" "$api" || die "could not read $api"
picked="$(js pick "$channel" < "$tmp/api.json")" || die "no $channel release found"
read -r latest url_tar url_sums url_sig <<EOF
$picked
EOF
case "$(js compare "$latest" "$current_release")" in
  newer) ;;
  same|older) say "Installed: $current_release ($current_channel). Newest on $channel: $latest. Up to date."; exit 0 ;;
  *) die "cannot compare $latest with $current_release" ;;
esac
say "Installed: $current_release ($current_channel). Newest on $channel: $latest."
if [ -n "$unattended" ] && [ "$(cat "$FK_BASE/auto-skip" 2>/dev/null || true)" = "$latest" ]; then
  say "Skipping $latest: it did not start on an earlier unattended run. A newer release will be tried."; exit 0
fi
if [ "$mode" = check ]; then say "An update is available. Run feedbackkit-update to install it."; exit 10; fi
[ -n "$url_tar" ] && [ -n "$url_sums" ] && [ -n "$url_sig" ] || die "release $latest lacks the tarball, SHA256SUMS or SHA256SUMS.sig"

# ---- download and verify --------------------------------------------------------------
name="feedbackkit-v$latest.tar.gz"
for pair in "$name|$url_tar" "SHA256SUMS|$url_sums" "SHA256SUMS.sig|$url_sig"; do
  curl -fsSL --retry 3 --max-time 600 -A feedbackkit-update -o "$tmp/${pair%%|*}" "${pair#*|}" || die "download of ${pair%%|*} failed"
done
# The trust root is the key list of the release that is installed now. A dev key is
# accepted on the dev channel only.
keys="$tmp/allowed_signers"; : > "$keys"
addkey() { [ -r "$1" ] || return 0; read -r type blob _ < "$1"; printf '%s namespaces="%s" %s %s\n' "$2" "$NAMESPACE" "$type" "$blob" >> "$keys"; }
addkey "$current_dir/release-keys/stable.pub" release-stable
if [ "$channel" = dev ]; then addkey "$current_dir/release-keys/dev.pub" release-dev; fi
[ -s "$keys" ] || die "no release key found in $current_dir/release-keys"
verified=""
for who in release-stable release-dev; do
  grep -q "^$who " "$keys" || continue
  if ssh-keygen -Y verify -f "$keys" -I "$who" -n "$NAMESPACE" -s "$tmp/SHA256SUMS.sig" < "$tmp/SHA256SUMS" >/dev/null 2>&1; then verified="$who"; break; fi
done
[ -n "$verified" ] || die "the signature of SHA256SUMS does not verify against the release keys. Nothing was changed."
# Each channel has its own key: a stable release carries the stable signature, a dev build the dev one.
case "$latest" in
  *-dev.*) [ "$verified" = release-dev ] || die "dev build $latest is not signed with the dev key. Nothing was changed." ;;
  *) [ "$verified" = release-stable ] || die "release $latest is signed with the dev key, which stable releases must not use. Nothing was changed." ;;
esac
line="$(grep "  $name\$" "$tmp/SHA256SUMS" || true)"
[ -n "$line" ] || die "SHA256SUMS does not list $name. Nothing was changed."
( cd "$tmp" && printf '%s\n' "$line" | $SHA -c - >/dev/null 2>&1 ) || die "the checksum of $name does not match. Nothing was changed."
say "Signature ($verified) and checksum are valid."

# ---- unpack and check the bundle --------------------------------------------------------
mkdir -p "$FK_BASE/releases"
stage="$FK_BASE/releases/.new-$latest"; rm -rf "$stage"; mkdir "$stage"
tar -xzf "$tmp/$name" -C "$stage" || { rm -rf "$stage"; die "the tarball cannot be unpacked. Nothing was changed."; }
inner="$stage/feedbackkit-v$latest"
[ "$(ls -A "$stage")" = "feedbackkit-v$latest" ] || die "the tarball must hold exactly one directory, feedbackkit-v$latest. Nothing was changed."
[ -f "$inner/bundle.json" ] && [ -f "$inner/server.mjs" ] || { rm -rf "$stage"; die "the tarball is not a FeedbackKit release. Nothing was changed."; }
read -r got_release _ got_schema <<EOF
$(js release "$inner/bundle.json")
EOF
[ "$got_release" = "$latest" ] || { rm -rf "$stage"; die "bundle.json says $got_release, the release is $latest. Nothing was changed."; }
# A copy of this release can already be on disk, for example the one a rollback went back from.
# The new one is verified, so it replaces it.
rm -rf "$FK_BASE/releases/$latest"
mv "$inner" "$FK_BASE/releases/$latest"; rm -rf "$stage"; stage=""

# ---- switch, with a copy of the data and a way back --------------------------------------
old="$(basename "$current_dir")"
old_previous="$(link_target previous)"
say "Updating $old to $latest. The service stops for a moment."
service stop
# The new copy is made before any older one goes, so a failed update keeps the way back it had.
partial="$FK_DATA_DIR.backup-$old.partial"; rm -rf "$partial"
cp -a "$FK_DATA_DIR" "$partial" || { rm -rf "$partial"; service start; die "the data copy failed (disk full?). The old release is running again."; }
rm -rf "$FK_DATA_DIR.backup-$old"; mv "$partial" "$FK_DATA_DIR.backup-$old"
link previous "releases/$old"
link current "releases/$latest"
service start
if healthy "$latest"; then
  # Keep the two newest releases and the data copy that belongs to the one before.
  for d in "$FK_BASE"/releases/*; do
    b="$(basename "$d")"; [ "$b" = "$latest" ] || [ "$b" = "$old" ] || rm -rf "$d"
  done
  for b in "$FK_DATA_DIR".backup-*; do [ "$b" = "$FK_DATA_DIR.backup-$old" ] || rm -rf "$b"; done
  rm -f "$FK_BASE/auto-skip"
  say "Updated to $latest. Run feedbackkit-update --rollback to go back."
  exit 0
fi
say "Release $latest did not become healthy. Restoring $old and its data."
[ -z "$unattended" ] || printf '%s\n' "$latest" > "$FK_BASE/auto-skip"
service stop || true
rm -rf "$FK_DATA_DIR"; cp -a "$FK_DATA_DIR.backup-$old" "$FK_DATA_DIR"
link current "releases/$old"
if [ -n "$old_previous" ]; then link previous "releases/$old_previous"; else rm -f "$FK_BASE/previous"; fi
rm -rf "$FK_BASE/releases/$latest"
service start
if healthy "$old"; then
  rm -rf "$FK_DATA_DIR.backup-$old"
  die "the update to $latest failed and $old is running again with its data"
fi
die "the update to $latest failed and $old did not start either. The data copy is $FK_DATA_DIR.backup-$old"
