#!/bin/sh
# feedbackkit-admin: the host commands for accounts on the standalone server
# (docs/SELF_HOSTING.md). POSIX sh, runs the server file of the release it sits in.
#
#   feedbackkit-admin setup-link [--minutes N]                      link for the first owner
#   feedbackkit-admin recovery-link [--user NAME] [--minutes N]     link that replaces a user's passkeys
#   feedbackkit-admin users                                         list the users (`accounts` still works)
#
# Run it with sudo: it reads /etc/feedbackkit.env as root, then continues as the user that owns
# the data directory:
#   sudo feedbackkit-admin setup-link
set -eu
self="$0"
# Follow a symlink such as /usr/local/bin/feedbackkit-admin to the release directory.
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in /*) self="$target" ;; *) self="$(dirname "$self")/$target" ;; esac
done
here="$(cd "$(dirname "$self")" && pwd -P)"
command -v node >/dev/null 2>&1 || { echo "feedbackkit-admin: node is required" >&2; exit 1; }
exec node "$here/server.mjs" admin "$@"
